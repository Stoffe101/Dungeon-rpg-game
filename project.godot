; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kindled Deep"
config/description="A 2.5D action roguelite dungeon crawler with deep incremental progression."
config/version="0.1.0"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.039, 0.07, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Settings="*res://src/autoload/settings.gd"
Profile="*res://src/autoload/profile.gd"
Audio="*res://src/autoload/audio.gd"
Game="*res://src/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/default_theme_antialiasing=0

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false
}

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.02, 0.018, 0.035, 1)
